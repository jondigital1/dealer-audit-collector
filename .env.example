# The one key, free (no billing account). Leave it empty to read PageSpeed's numbers from the report page instead.
# Keys stay on the VM. Never paste them into a chat. No SpyFu key, no Places API: those are Chrome steps.
PSI_API_KEY=
# Where finished store zips go (Decision 4). taildrop sends each zip to the Desktop PC's Downloads;
# folder copies it into HANDOFF_DIR, which Syncthing mirrors to C:\Users\jon\AuditCaptures.
HANDOFF_MODE=taildrop
HANDOFF_DIR=/home/jonneale83/audit-handoff
TAILDROP_TARGET=jon-d1-pc-2
# Stores captured at once on the 4-core VM
JOBS=3

# The sheet trigger reads the Dealer Audit Requests sheet with a service account the sheet is shared with as a Viewer
# (SETUP.md, "The sheet trigger"). The key file stays out of git (.secrets/ is ignored).
GOOGLE_SERVICE_ACCOUNT_JSON=/home/jonneale83/dealer-audit-collector/.secrets/service-account.json
